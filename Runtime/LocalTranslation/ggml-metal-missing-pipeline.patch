--- a/ggml-metal-device.m
+++ b/ggml-metal-device.m
@@ -96,7 +96,20 @@
     free(pipeline);
 }
 
+// Yullo: a kernel missing from the compiled libraries leaves a NULL pipeline. Reading
+// it crashed the process; now the graph fails instead (ggml_metal_take_missing_pipeline),
+// and the work that needed it is not dispatched.
+static atomic_bool ggml_metal_missing_pipeline = false;
+
+bool ggml_metal_take_missing_pipeline(void) {
+    return atomic_exchange(&ggml_metal_missing_pipeline, false);
+}
+
 int ggml_metal_pipeline_max_theads_per_threadgroup(struct ggml_metal_pipeline_with_params pipeline) {
+    if (!pipeline.pipeline) {
+        atomic_store(&ggml_metal_missing_pipeline, true);
+        return 1024;
+    }
     return pipeline.pipeline->obj.maxTotalThreadsPerThreadgroup;
 }
 
