-        GGML_ABORT("%s: nil Metal pipeline (missing kernel; see compile_pipeline log above)\n", __func__);
+        GGML_LOG_ERROR("%s: nil Metal pipeline (missing kernel; see compile_pipeline log above)\n", __func__);
+        atomic_store(&ggml_metal_missing_pipeline, true);
